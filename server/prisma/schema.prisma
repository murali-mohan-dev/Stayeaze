datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id              String           @id @default(uuid())
  name            String
  email           String           @unique
  password        String
  phone           String?
  role            String           @default("CUSTOMER") // "CUSTOMER" or "ADMIN"
  avatar          String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  bookings        Booking[]
  reviews         Review[]
  wishlists       Wishlist[]
  serviceRequests ServiceRequest[]
}

model Hotel {
  id              String           @id @default(uuid())
  name            String
  tagline         String?
  description     String
  address         String
  city            String
  state           String
  country         String           @default("India")
  postalCode      String?
  latitude        Float?
  longitude       Float?
  starRating      Int              @default(5)
  ratingScore     Float            @default(4.8)
  reviewCount     Int              @default(0)
  startingPrice   Float            @default(3000)
  featured        Boolean          @default(false)
  images          String           // JSON string of image URLs array
  amenities       String           // JSON string of amenities array
  checkInTime     String           @default("14:00")
  checkOutTime    String           @default("11:00")
  contactEmail    String
  contactPhone    String
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  roomCategories  RoomCategory[]
  rooms           Room[]
  bookings        Booking[]
  reviews         Review[]
  wishlists       Wishlist[]
  serviceRequests ServiceRequest[]
}

model RoomCategory {
  id               String    @id @default(uuid())
  hotelId          String
  name             String    // e.g., Deluxe Room, Executive Suite, Presidential Suite
  description      String
  basePrice        Float
  capacityAdults   Int       @default(2)
  capacityChildren Int       @default(1)
  bedType          String    @default("King Bed")
  sizeSqFt         Int       @default(350)
  images           String    // JSON string of room images
  amenities        String    // JSON string of room amenities
  totalRooms       Int       @default(10)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  hotel            Hotel     @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  rooms            Room[]
  bookings         Booking[]
}

model Room {
  id           String       @id @default(uuid())
  hotelId      String
  categoryId   String
  roomNumber   String
  floor        Int          @default(1)
  status       String       @default("AVAILABLE") // "AVAILABLE", "OCCUPIED", "MAINTENANCE"
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  hotel        Hotel        @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  category     RoomCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
}

model Booking {
  id                 String           @id @default(uuid())
  bookingReference   String           @unique
  userId             String
  hotelId            String
  categoryId         String
  checkInDate        DateTime
  checkOutDate       DateTime
  nights             Int
  numRooms           Int              @default(1)
  numGuests          Int              @default(2)
  guestName          String
  guestEmail         String
  guestPhone         String
  specialRequests    String?
  selectedRoomNumbers String?         // JSON array or comma separated
  roomPrice          Float
  extraServicesPrice Float            @default(0)
  taxes              Float            @default(0)
  discountAmount     Float            @default(0)
  totalAmount        Float
  status             String           @default("CONFIRMED") // "CONFIRMED", "CHECKED_IN", "CHECKED_OUT", "CANCELLED"
  couponCode         String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  user               User             @relation(fields: [userId], references: [id])
  hotel              Hotel            @relation(fields: [hotelId], references: [id])
  category           RoomCategory     @relation(fields: [categoryId], references: [id])
  payment            Payment?
  serviceRequests    ServiceRequest[]
}

model Payment {
  id            String    @id @default(uuid())
  bookingId     String    @unique
  amount        Float
  currency      String    @default("INR")
  method        String    // "UPI", "CREDIT_CARD", "DEBIT_CARD", "PAY_AT_HOTEL"
  transactionId String    @unique
  status        String    @default("SUCCESS") // "SUCCESS", "PENDING", "FAILED", "REFUNDED"
  paymentDate   DateTime  @default(now())

  booking       Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)
}

model Review {
  id        String   @id @default(uuid())
  userId    String
  hotelId   String
  rating    Int      @default(5)
  title     String
  comment   String
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  hotel     Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)
}

model Wishlist {
  id        String   @id @default(uuid())
  userId    String
  hotelId   String
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  hotel     Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)

  @@unique([userId, hotelId])
}

model Coupon {
  id               String   @id @default(uuid())
  code             String   @unique
  description      String
  discountType     String   @default("PERCENTAGE") // "PERCENTAGE", "FIXED"
  discountValue    Float
  minBookingAmount Float    @default(0)
  maxDiscount      Float?
  validUntil       DateTime
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
}

model ServiceRequest {
  id          String    @id @default(uuid())
  bookingId   String
  hotelId     String
  userId      String
  roomNumber  String
  serviceType String    // "ROOM_CLEANING", "FOOD_BEVERAGE", "LAUNDRY", "EXTRA_TOWELS", "MAINTENANCE", "AIRPORT_PICKUP"
  details     String?
  status      String    @default("PENDING") // "PENDING", "ACCEPTED", "IN_PROGRESS", "COMPLETED"
  requestedAt DateTime  @default(now())
  completedAt DateTime?

  booking     Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  hotel       Hotel     @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}
